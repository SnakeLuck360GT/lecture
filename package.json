{
  "name": "lecscribe",
  "version": "0.1.0",
  "description": "LecScribe: an on-device lecture companion (QVAC AI + Pears P2P).",
  "private": true,
  "type": "module",
  "main": "src/core/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "start:mock": "node scripts/start.js --mock",
    "test": "node tests/run.mjs",
    "lint": "node scripts/check-syntax.js",
    "sim-taps": "node scripts/sim-taps.js",
    "ai:warm": "node src/ai/scripts/warm.js",
    "ai:live-demo": "node src/ai/scripts/live-demo.js",
    "package": "electron-forge package --platform=darwin --arch=arm64",
    "make": "electron-forge make --platform=darwin --arch=arm64",
    "package:win": "electron-forge package --platform=win32 --arch=x64",
    "icon": "electron scripts/make-icon.js"
  },
  "dependencies": {
    "@qvac/sdk": "0.23.0",
    "b4a": "^1.9.0",
    "corestore": "^7.16.1",
    "hypercore": "^11.40.3",
    "hypercore-id-encoding": "^1.3.0",
    "hyperdrive": "^13.3.4",
    "hyperswarm": "^4.17.2",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-base": "^7.11.2",
    "electron": "33.4.11",
    "hyperdht": "^6.0.0",
    "png2icons": "^2.0.1"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
